APP_NAME=OrganizaSe
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Banco de dados relacional (MySQL ou PostgreSQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=organizaseplus
DB_USERNAME=root
DB_PASSWORD=

# JWT (troque por um novo secret gerado, NÃO reutilize o antigo que vazou)
JWT_SECRET=

# E-mail de suporte (gere uma nova senha de app do Gmail, a antiga vazou)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=organizaseplus@gmail.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=organizaseplus@gmail.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SUPPORT_TO=organizaseplus@gmail.com

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
